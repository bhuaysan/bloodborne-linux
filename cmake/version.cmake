# Writes the build's version into a source file (docs/releasing.md). Run in script mode at every
# build by the bb_version_source target (src/common/CMakeLists.txt), so a new tag or commit shows
# without a reconfigure; the file is rewritten only when the version changed.
#
#   cmake -DSOURCE_DIR=<checkout> -DOUTPUT=<file.cpp> [-DVERSION=<override>] -P version.cmake
#
# The version is `git describe` against the release tags: v0.2.0 on a tagged commit,
# v0.2.0-3-gabc1234 three commits later, with -dirty for uncommitted changes. Before the first
# release tag it is dev-<commit>. VERSION overrides it, for builds from a source archive without
# git.

if(NOT VERSION)
    execute_process(
        COMMAND git describe --tags --match "v[0-9]*" --dirty --always
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE VERSION
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE git_result)
    if(NOT git_result EQUAL 0 OR VERSION STREQUAL "")
        set(VERSION "unknown")
    elseif(NOT VERSION MATCHES "^v[0-9]")
        set(VERSION "dev-${VERSION}")
    endif()
endif()

file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT [[
// Generated by cmake/version.cmake at build time. Do not edit.
#include "common/version.hpp"

namespace bb::common {

std::string_view build_version() {
    return "@VERSION@";
}

}  // namespace bb::common
]] @ONLY)
