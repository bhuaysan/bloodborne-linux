# The 25-minute run of the R5 acceptance: continue from the save of r5-acceptance into the clinic
# and play there for 25 minutes with simple scripted input: the stick back and forth, the lock-on
# and the camera. Start it with --user-from the user/ directory of an r5-acceptance run.
# The picture must change when the stick moves, and one is saved a minute.
limit time=2200

log 'sceSystemServiceHideSplashScreen|Vo5V8KAwCmk' timeout=150
sleep 1
tap A                   # the notice about an unclean end of the last session, when there is one
mark logos
stable seconds=6 delta=1 timeout=120
dpad D                  # Play Offline
tap A
# Notices (the network, offline mode, an unclean end of the last session) come and go, so these
# presses may hit a notice or Continue, the first entry. Once in the clinic they do nothing.
tap A count=6 gap=3
mark continue
sleep 20                # the load
stable seconds=3 delta=1 timeout=60
sleep 10                # the loading page, if it is still up, goes
stable seconds=3 delta=1 timeout=60
shot 00-clinic
mark soak

repeat 25
stick LY -32767
changed delta=1 timeout=15     # a hung game with a frozen picture fails here
sleep 4
stick LY 32767
sleep 4
neutral
stick RX 20000
sleep 3
neutral
tap R3
sleep 2
tap R3
sleep 45
shot minute-{i}
end
