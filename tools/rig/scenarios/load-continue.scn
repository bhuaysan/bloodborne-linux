# Load time of Continue (#655): from the title through Play Offline to Continue, with a picture
# every second until the hunter is under control. Run it with --user-from a save (the clinic's or
# Central Yharnam's) and read the time with `tools/rig/load_times.py RUN...`.
# The notices after Play Offline come in different numbers, so the A presses are single steps:
# load_times.py takes the press after which the game starts its load (a PlayGo call both targets
# log) as the Continue press, and the first picture with the HUD's stamina bar as the end.
limit time=300

log 'sceSystemServiceHideSplashScreen|Vo5V8KAwCmk' timeout=150
sleep 1
tap A                   # the notice about an unclean end of the last session, when there is one
mark logos
nonblack level=12 timeout=120   # the title (mean level 23); the logos stay below 8
stable seconds=6 delta=1 timeout=120
dpad D                  # Play Offline
tap A
mark menu
repeat 6                # notices, then Continue; once loading the presses do nothing
tap A
sleep 0.8
shot t{i}a
sleep 0.8
shot t{i}b
sleep 0.8
shot t{i}c
end
repeat 30
sleep 0.8
shot w{i}
end
