# Death and respawn in Central Yharnam (#537): continue from the `yharnam-enemies` save (made by
# playing the reference by hand to just before a group of living enemies; `--user-from` takes its
# user/ directory for both targets), walk out a few steps and stand still until the enemies kill
# the hunter. The game then shows YOU DIED, loads and puts the hunter back at the lantern. The
# shots after the respawn (02 onwards) show the lantern area, which must look like the reference's.
limit time=500

log 'sceSystemServiceHideSplashScreen|Vo5V8KAwCmk' timeout=150
sleep 1
tap A                   # the notice about an unclean end of the last session, when there is one
mark logos
nonblack level=12 timeout=120   # the title (mean level 23); the logos stay below 8
stable seconds=6 delta=1 timeout=120
dpad D                  # Play Offline
tap A
tap A count=6 gap=3     # notices, then Continue
mark continue
sleep 20                # the load
stable seconds=3 delta=1 timeout=60
shot 00-start

mark play-idle
stick LY -32767         # walk out to the enemies
sleep 4
neutral
sleep 30
shot 01-idle30
sleep 30
shot 02-idle60
sleep 20
shot 03-idle80
sleep 20
shot 04-idle100
sleep 20
shot 05-idle120
