#!/bin/sh
# Blocks commits that would leak personal data, agent files or game data.
. "$(dirname "$0")/privacy-lib.sh"
FAILED=0

# 1. identity
email="$(git config user.email)"
case "$email" in
    *@users.noreply.github.com) ;;
    *) fail "user.email must be a GitHub noreply address (got a different address)" ;;
esac

# 2. forbidden file names
git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
    path_problem "$f"
    size="$(git cat-file -s ":$f" 2>/dev/null || echo 0)"
    limit="$(size_limit "$f")"
    [ "$size" -gt "$limit" ] && echo "file too large ($size bytes): $f"
done > "${TMPDIR:-/tmp}/bbl-precommit.$$"
if [ -s "${TMPDIR:-/tmp}/bbl-precommit.$$" ]; then
    while IFS= read -r msg; do fail "$msg"; done < "${TMPDIR:-/tmp}/bbl-precommit.$$"
fi
rm -f "${TMPDIR:-/tmp}/bbl-precommit.$$"

# 3. content of added lines
pat="$(privacy_pattern)"
hits="$(git diff --cached -U0 --no-color | grep -E '^\+[^+]' | grep -nE -i -- "$pat")"
if [ -n "$hits" ]; then
    fail "staged changes contain personal data or absolute paths:"
    printf '%s\n' "$hits" | head -20 >&2
fi

[ "$FAILED" -eq 0 ] || { echo "commit blocked. Fix the issues above (do not use --no-verify)." >&2; exit 1; }
exit 0
